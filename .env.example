CAYADEV_CLIENT_ID=your_client_id
CAYADEV_CLIENT_SECRET=your_client_secret
CAYADEV_REDIRECT_URI=http://localhost:3000/auth/cayadev/callback
CAYADEV_SCOPE=profile:read email:read avatar:read
SESSION_TTL_MS=43200000

# ── Proxy / üretim ortamı ──────────────────────────────────────────────────
# Nginx / Caddy / Cloudflare gibi bir reverse proxy arkasında çalışıyorsa
# aşağıdaki ayarları yapın:
#
# TRUST_PROXY=true          → Express, X-Forwarded-For ve X-Forwarded-Proto
#                             başlıklarına güvenir; req.ip ve req.protocol
#                             doğru IP / protokolü yansıtır.
#                             Rate-limit ve OAuth redirect_uri için GEREKLİ.
#
# NODE_ENV=production       → Cookie'lere Secure bayrağı eklenir (HTTPS zorunlu).
#
# COOKIE_SECURE=true        → NODE_ENV production değilken de Secure flag ister.
#
# APP_BASE_PATH=/cayasportpanel
#                           → Uygulama bir alt dizinde yayınlanıyorsa server
#                             redirect_uri ve bazı sunucu yönlendirmeleri için
#                             bu prefix'i kullanır.
#
# CAYADEV_REDIRECT_URI=https://alan-adiniz.com/auth/cayadev/callback
#                           → Proxy TLS sonlandırıyorsa bunu elle ayarlayın;
#                             aksi hâlde URL X-Forwarded-Proto'dan otomatik
#                             türetilir (yine de elle ayarlamak daha güvenli).
#
# DATA_ENCRYPTION_KEY=      → 32-byte AES anahtarı (base64). Üretimde
#                             .master.key dosyası yerine bunu kullanın.
# ──────────────────────────────────────────────────────────────────────────
